# Copy this file to .env and replace the placeholder values with your real settings.
# Do not commit the real .env file to GitHub.

# Nemotron 3 Ultra Free Configuration
NEMOTRON_API_KEY=your_nemotron_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3-ultra
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Prediction service configuration
MODEL_ENDPOINT=https://your-model-endpoint.example.com
MODEL_NAME=ChemStudio Reaction Predictor
MODEL_VERSION=1.0
MODEL_TIMEOUT=60

# Retrieval / vector database configuration
Embedding_MODEL=BAAI/bge-small-en-v1.5
CHROMA_COLLECTION_NAME=chemistry_literature_bge_small
CHROMA_PERSIST_DIRECTORY=database/chroma
BM25_INDEX_PATH=database/bm25_index.json

# Frontend configuration
CHEMSTUDIO_API_URL=http://127.0.0.1:8000
CHEMSTUDIO_UPLOAD_DIRECTORY=database/uploads
